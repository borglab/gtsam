fgz 1
style node_size=9.5mm factor_size=3.5mm label_sep=0.2pt label_font=small

x0 = x_{k-3}
x1 = x_{k-2}
x2 = x_{k-1}
x3 = x_k
p = p
u = u
z1 = z_{k-2}
z2 = z_{k-1}
z3 = z_k

variable x0 (0, 0)
variable x1 (3.5, 0)
variable x2 (7, 0)
variable x3 (10.5, 0)

factor {x0, x1} shape=square
factor {x1, x2} shape=square
factor {x2, x3} shape=square

factor {x0} (0, 1.4) shape=square
factor {x1} (3.5, 1.4) shape=square
factor {x2} (7, 1.4) shape=square
factor {x3} (10.5, 1.4) shape=square

text u (1.75, -0.55) font=scriptsize
text u (5.25, -0.55) font=scriptsize
text u (8.75, -0.55) font=scriptsize

text p (0, 1.95) font=scriptsize
text z1 (3.5, 1.95) font=scriptsize
text z2 (7, 1.95) font=scriptsize
text z3 (10.5, 1.95) font=scriptsize
